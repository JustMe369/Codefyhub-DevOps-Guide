# Local development only. Change the password before first use.
POSTGRES_USER=devops_guide
POSTGRES_PASSWORD=replace_with_a_long_local_password
POSTGRES_DB=devops_guide
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devops_guide:replace_with_a_long_local_password@127.0.0.1:5432/devops_guide?schema=public
# Optional. Set this only after an editorial review; it is never advanced automatically.
CONTENT_VERIFIED_AT=2026-10-26
# Set this for public deployment. Keep it unset for the private local guide.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/JustMe369/Codefyhub-DevOps-Guide

# Admin control plane. Generate BETTER_AUTH_SECRET with: npx auth@latest secret
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub account emails permitted to enter the admin control plane.
ADMIN_EMAILS=
# Optional one-time local bootstrap identity. Do not commit a real password.
ADMIN_BOOTSTRAP_EMAIL=admin@codefyhub.local
ADMIN_BOOTSTRAP_PASSWORD=
