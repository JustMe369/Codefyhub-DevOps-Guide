generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  CONCEPT
  HOW_TO
  RUNBOOK
  REFERENCE
  CONFIGURATION_RECIPE
  LEARNING_PATH
}

enum ValidationStatus {
  DRAFT
  SOURCE_REVIEWED
  LAB_TESTED
}

model Section {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String
  icon      String
  order     Int           @unique
  status    ContentStatus @default(PUBLISHED)
  articles  Article[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Article {
  id                  String           @id @default(cuid())
  sectionId           String
  section             Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  description         String
  body                String           @db.Text
  embedding           Unsupported("vector(384)")?
  difficulty          Difficulty       @default(FOUNDATION)
  contentType         ContentType      @default(CONCEPT)
  validationStatus    ValidationStatus @default(DRAFT)
  applicablePlatforms String[]         @default([])
  applicableVersions  String[]         @default([])
  prerequisites       String[]         @default([])
  relatedGuides       String[]         @default([])
  testedAt            DateTime?
  testEnvironment     String?
  readingMinutes      Int
  order               Int
  status              ContentStatus    @default(PUBLISHED)
  publishedAt         DateTime?
  lastVerifiedAt      DateTime
  verifiedBy          String           @default("Codefyhub Editorial Team")
  verificationMethod  String           @default("Documentation and lab review")
  testedVersions      String           @default("See article and source documentation")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  versions            ArticleVersion[]
  articleSources      ArticleSource[]
  articleTags         ArticleTag[]
  glossaryTerms       GlossaryTerm[]

  @@unique([sectionId, slug])
  @@unique([sectionId, order])
  @@index([status, publishedAt])
  @@index([title])
}

model ArticleVersion {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision      Int
  body          String   @db.Text
  changeSummary String
  snapshot      Json?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([articleId, revision])
}

model Source {
  id             String          @id @default(cuid())
  title          String
  organization   String
  url            String          @unique
  sourceType     String
  accessedAt     DateTime
  lastVerifiedAt DateTime
  verifiedBy     String          @default("Codefyhub Editorial Team")
  articleSources ArticleSource[]
}

model ArticleSource {
  articleId  String
  sourceId   String
  note       String?
  claimScope String?
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source     Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String       @unique
  articleTags ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model GlossaryTerm {
  id               String   @id @default(cuid())
  term             String   @unique
  definition       String   @db.Text
  relatedArticleId String?
  relatedArticle   Article? @relation(fields: [relatedArticleId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([term])
}

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  role            String?
  banned          Boolean?         @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]
  articleVersions ArticleVersion[]
  auditEvents     AuditEvent[]

  @@unique([email])
  @@map("user")
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
