generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentVisibility {
  PUBLIC
  INTERNAL
  RESTRICTED
  DRAFT
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  CONCEPT
  HOW_TO
  RUNBOOK
  REFERENCE
  CONFIGURATION_RECIPE
  LEARNING_PATH
  FAQ
  /// Retained while legacy Article rows still use this value.
  WORKFLOW
  ISSUE_SOLUTION
  POLICY
}

enum ValidationStatus {
  DRAFT
  SOURCE_REVIEWED
  LAB_TESTED
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum KnowledgeRequestStatus {
  OPEN
  PLANNED
  RESOLVED
  DISMISSED
}

model Section {
  id        String        @id @default(cuid())
  companyId String        @default("codefyhub-company")
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  summary   String
  icon      String
  order     Int
  status    ContentStatus @default(PUBLISHED)
  articles  Article[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([companyId, slug])
  @@unique([companyId, order])
  @@index([companyId, status])
}

model Article {
  id                  String                      @id @default(cuid())
  companyId           String                      @default("codefyhub-company")
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sectionId           String
  section             Section                     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  description         String
  body                String                      @db.Text
  embedding           Unsupported("vector(384)")?
  difficulty          Difficulty                  @default(FOUNDATION)
  contentType         ContentType                 @default(CONCEPT)
  validationStatus    ValidationStatus            @default(DRAFT)
  reviewStatus        ReviewStatus                @default(DRAFT)
  reviewDueAt         DateTime?
  reviewedAt          DateTime?
  reviewedById        String?
  reviewNote          String?
  expiresAt           DateTime?
  applicablePlatforms String[]                    @default([])
  applicableVersions  String[]                    @default([])
  prerequisites       String[]                    @default([])
  relatedGuides       String[]                    @default([])
  testedAt            DateTime?
  testEnvironment     String?
  readingMinutes      Int
  order               Int
  status              ContentStatus               @default(PUBLISHED)
  visibility          ContentVisibility           @default(INTERNAL)
  publishedAt         DateTime?
  lastVerifiedAt      DateTime
  verifiedBy          String                      @default("Codefyhub Editorial Team")
  verificationMethod  String                      @default("Documentation and lab review")
  testedVersions      String                      @default("See article and source documentation")
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  versions            ArticleVersion[]
  articleSources      ArticleSource[]
  articleTags         ArticleTag[]
  glossaryTerms       GlossaryTerm[]
  resolvedRequests    KnowledgeRequest[]          @relation("ResolvedKnowledgeRequest")

  @@unique([sectionId, slug])
  @@unique([sectionId, order])
  @@index([companyId, status, visibility])
  @@index([status, publishedAt])
  @@index([title])
  @@index([contentType, difficulty, validationStatus], map: "Article_content_discovery_idx")
}

model ArticleVersion {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision      Int
  body          String   @db.Text
  changeSummary String
  snapshot      Json?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([articleId, revision])
}

model Source {
  id             String          @id @default(cuid())
  companyId      String          @default("codefyhub-company")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  organization   String
  url            String
  sourceType     String
  accessedAt     DateTime        @default(now())
  lastVerifiedAt DateTime
  verifiedBy     String          @default("Codefyhub Editorial Team")
  articleSources ArticleSource[]

  @@unique([companyId, url])
  @@index([companyId, organization])
}

model ArticleSource {
  articleId  String
  sourceId   String
  note       String?
  claimScope String?
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source     Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model Tag {
  id          String       @id @default(cuid())
  companyId   String       @default("codefyhub-company")
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  articleTags ArticleTag[]

  @@unique([companyId, slug])
  @@unique([companyId, name])
  @@index([companyId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model GlossaryTerm {
  id               String   @id @default(cuid())
  companyId        String   @default("codefyhub-company")
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  term             String
  definition       String   @db.Text
  relatedArticleId String?
  relatedArticle   Article? @relation(fields: [relatedArticleId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@unique([companyId, term])
  @@index([companyId, term])
}

model Company {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  status            CompanyStatus      @default(ACTIVE)
  isPublic          Boolean            @default(false)
  logoData          Bytes?
  logoMimeType      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  memberships       Membership[]
  roles             CompanyRole[]
  sections          Section[]
  articles          Article[]
  sources           Source[]
  tags              Tag[]
  glossary          GlossaryTerm[]
  auditEvents       AuditEvent[]
  invitations       MemberInvitation[]
  knowledgeRequests KnowledgeRequest[]
}

model Membership {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String
  role          CompanyRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status        MembershipStatus @default(ACTIVE)
  accessVersion Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, roleId])
}

model CompanyRole {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  permissions RolePermission[]
  invitations MemberInvitation[]

  @@unique([companyId, slug])
  @@unique([companyId, name])
  @@index([companyId])
}

model MemberInvitation {
  id           String           @id @default(cuid())
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId       String
  role         CompanyRole      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  email        String
  name         String
  tokenHash    String           @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  createdAt    DateTime         @default(now())
  acceptedAt   DateTime?

  @@index([companyId, status, expiresAt])
  @@index([email, status])
}

model KnowledgeRequest {
  id                String                 @id @default(cuid())
  companyId         String
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  query             String
  queryNormalized   String
  context           String?
  status            KnowledgeRequestStatus @default(OPEN)
  occurrenceCount   Int                    @default(1)
  requestedById     String?
  requestedBy       User?                  @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  resolvedArticleId String?
  resolvedArticle   Article?               @relation("ResolvedKnowledgeRequest", fields: [resolvedArticleId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  lastRequestedAt   DateTime               @default(now())
  resolvedAt        DateTime?

  @@unique([companyId, queryNormalized])
  @@index([companyId, status, occurrenceCount])
}

model Permission {
  key         String           @id
  group       String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [key], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                String             @id
  name              String
  email             String
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  role              String?
  banned            Boolean?           @default(false)
  banReason         String?
  banExpires        DateTime?
  sessions          Session[]
  accounts          Account[]
  articleVersions   ArticleVersion[]
  auditEvents       AuditEvent[]
  memberships       Membership[]
  knowledgeRequests KnowledgeRequest[]

  @@unique([email])
  @@map("user")
}

model AuditEvent {
  id         String   @id @default(cuid())
  companyId  String   @default("codefyhub-company")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
