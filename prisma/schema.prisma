generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  CONCEPT
  HOW_TO
  RUNBOOK
  REFERENCE
  CONFIGURATION_RECIPE
  LEARNING_PATH
}

enum ValidationStatus {
  DRAFT
  SOURCE_REVIEWED
  LAB_TESTED
}

model Section {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String
  icon      String
  order     Int           @unique
  status    ContentStatus @default(PUBLISHED)
  articles  Article[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Article {
  id                  String           @id @default(cuid())
  sectionId           String
  section             Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug                String
  title               String
  description         String
  body                String           @db.Text
  difficulty          Difficulty       @default(FOUNDATION)
  contentType         ContentType      @default(CONCEPT)
  validationStatus    ValidationStatus @default(DRAFT)
  applicablePlatforms String[]         @default([])
  applicableVersions  String[]         @default([])
  prerequisites       String[]         @default([])
  relatedGuides       String[]         @default([])
  testedAt            DateTime?
  testEnvironment     String?
  readingMinutes      Int
  order               Int
  status              ContentStatus    @default(PUBLISHED)
  publishedAt         DateTime?
  lastVerifiedAt      DateTime
  verifiedBy          String           @default("Codefyhub Editorial Team")
  verificationMethod  String           @default("Documentation and lab review")
  testedVersions      String           @default("See article and source documentation")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  versions            ArticleVersion[]
  articleSources      ArticleSource[]
  articleTags         ArticleTag[]
  glossaryTerms       GlossaryTerm[]

  @@unique([sectionId, slug])
  @@unique([sectionId, order])
  @@index([status, publishedAt])
  @@index([title])
}

model ArticleVersion {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revision      Int
  body          String   @db.Text
  changeSummary String
  snapshot      Json?
  createdAt     DateTime @default(now())

  @@unique([articleId, revision])
}

model Source {
  id             String          @id @default(cuid())
  title          String
  organization   String
  url            String          @unique
  sourceType     String
  accessedAt     DateTime
  lastVerifiedAt DateTime
  verifiedBy     String          @default("Codefyhub Editorial Team")
  articleSources ArticleSource[]
}

model ArticleSource {
  articleId  String
  sourceId   String
  note       String?
  claimScope String?
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source     Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String       @unique
  articleTags ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model GlossaryTerm {
  id               String   @id @default(cuid())
  term             String   @unique
  definition       String   @db.Text
  relatedArticleId String?
  relatedArticle   Article? @relation(fields: [relatedArticleId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([term])
}
